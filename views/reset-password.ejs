<%- include('partials/header')-%>
<form action="">
     <h3>Reset your password</h3>
 <label for="">OTP</label>
 <input type="text" name="otp">
 <div class="otp error"></div>

 <label for="" name="new-password">new password</label>
 <input type="text" name="new_password">

 <label for="" name="confirm-password">confirm password</label>
 <input type="text" name="confirm_password">
 <div class="confirm error"></div>

 <button>Reset</button>
 <button type="button">resendOTP</button>
 <div class="resend error"></div>
</form>

 <script>
    const form = document.querySelector('form')
    const otpError = document.querySelector('.otp.error')
    const newPassError = document.querySelector('.confirm.error')
    const resendError = document.querySelector('.resend.error')

    const forgotEmail = sessionStorage.getItem('resetEmail')
    if(!forgotEmail) location.assign('/forgot-password')

    form.addEventListener('submit',async(e)=>{
        e.preventDefault()

    otpError.textContent = ''
    newPassError.textContent = ''

    //getting the new credentials 
    const otpInput = form.otp.value
    const newPass = form.new_password.value
    const confirmPass = form.confirm_password.value

    if(newPass !== confirmPass){
        newPassError.textContent = 'passwords do not match'
        return
    }

    const resp = await fetch('/reset-password',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({email,otpInput,newPass,confirmPass})
    })
    const data = await resp.json()
    if(data.error){
      return otpError.textContent = data.error
    }
    sessionStorage.removeItem('resetEmail')
    location.assign('/login')
    })
 </script>

