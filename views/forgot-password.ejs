<%- include('partials/header')-%>

<form action="">
    <h3>enter email to receive OTP for password reset</h3>
    <input type="text" name="email">
    <div class="email error"></div>
    <button>sendOTP</button>
</form>
<script>
    //getting input values
    const form = document.querySelector('form')
    
   
    //gettiing email errors
    const emailError = document.querySelector('.email.error')


    form.addEventListener('submit',async(e)=>{
        e.preventDefault()

        try {
           
              if(emailError) emailError.textContent = ''

        const forgotEmail = form.email.value.trim().toLowerCase()


            const resp = await fetch('/forgot-password',{
                method:'POST',
                headers:({'Content-Type':'application/json'}),
                body:JSON.stringify({forgotEmail})
            })
          const data = await resp.json() 
          if(data.errors){
            console.log(data.errors)
            emailError.textContent  = data.error || 'Something went wrong'
          }  

          sessionStorage.setItem('resetEmail',forgotEmail)
          location.assign('/reset-password')
        } catch (error) {
           //console.log({err:error.message})
           if(emailError) emailError.textContent = 'Could not reach the server'
        }
        
    })
</script>

<%- include('partials/footer')-%>
